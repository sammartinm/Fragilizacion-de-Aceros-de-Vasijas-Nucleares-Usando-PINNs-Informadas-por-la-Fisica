@article{dagata2025,
  title={The LYRA-10 Experiment: Irradiation of Light Water Reactor Pressure Vessel Steels...},
  author={D’Agata, E. and others},
  journal={Nuclear Science and Engineering},
  pages={1--17},
  year={2025},
  publisher={Taylor & Francis}
}

Este artículo detalla el experimento LYRA-10, centrado en la irradiación de aceros empleados en vasijas de reactores de agua ligera. Analiza de forma sistemática cómo influyen las variaciones de elementos como el níquel, manganeso y silicio en la degradación de la aleación. Su propósito fundamental es evaluar y cuantificar la fragilización que sufren estos materiales críticos bajo condiciones de operación extendida.

Esta referencia se introduce porque aporta la evidencia empírica directa que respalda el problema de la fragilización de la vasija mencionado al cierre del párrafo. Al conectar la teoría con un estudio experimental de vanguardia, se valida técnicamente que la degradación metalúrgica es el factor limitante clave en la LTO. Esto transforma una afirmación general en un argumento sólido y fundamentado con literatura científica actual.

@article{liu2022machine,
  title={Machine learning predictions of irradiation embrittlement in reactor pressure vessel steels},
  author={Liu, Yu-chen and Wu, Henry and Mayeshiba, Tam and Afflerbach, Benjamin and Jacobs, Ryan and Perry, Josh and George, Jerit and Cordell, Josh and Xia, Jinyu and Yuan, Hao and others},
  journal={npj Computational Materials},
  volume={8},
  number={1},
  pages={85},
  year={2022},
  publisher={Nature Publishing Group},
  doi={10.1038/s41524-022-00760-4}
}

Este estudio utiliza regresión de cresta de núcleo gaussiano para predecir el endurecimiento de aceros de vasija en extensiones de vida de 60 a 100 años. Basándose en la base de datos IVAR+, demuestra que el aprendizaje automático supera a modelos tradicionales como ASTM E900 en regímenes de alta fluencia. No obstante, advierte que estos modelos pueden fallar al extrapolar si no capturan fenómenos físicos clave como la saturación del material.

Se integra como la referencia de mayor impacto para validar que los modelos de aprendizaje automático actuales detectan eficazmente patrones no lineales complejos. Su mención justifica la transición hacia las PINNs al evidenciar que los modelos no informados pueden generar pronósticos físicamente inconsistentes cuando los datos son escasos. Actúa como el anclaje crítico que expone la necesidad de integrar leyes físicas para garantizar la fiabilidad en la operación a largo plazo.

@article{karniadakis2021,
  title={Physics-informed machine learning},
  author={Karniadakis, George Em and Kevrekidis, Ioannis G and Lu, Lu and Perdikaris, Paris and Wang, Sifan and Yang, Liu},
  journal={Nature Reviews Physics},
  volume={3},
  number={6},
  pages={422--440},
  year={2021},
  publisher={Nature Publishing Group}
}

Esta obra de revisión fundamental establece los principios teóricos, metodologías clave y aplicaciones del aprendizaje automático informado por la física. Explica detalladamente cómo integrar leyes físicas, ecuaciones diferenciales y restricciones matemáticas en la arquitectura de las redes neuronales profundas. Finalmente, demuestra la superioridad de este enfoque para resolver problemas con datos escasos o en escenarios de extrapolación compleja.

Se introduce inmediatamente después de nombrar las PINNs por ser el marco de referencia definitivo que legitima teóricamente este cambio de paradigma técnico. Su colocación actúa como el ancla conceptual del TFM, demostrando que la estrategia elegida está respaldada por la comunidad científica internacional de alto impacto. Funciona como el aval técnico que justifica que tu propuesta es la solución ideal para el problema de la falta de datos.

@article{odette2019history,
  title={On the history and status of reactor pressure vessel steel ductile to brittle transition temperature shift prediction models},
  author={Odette, G. R. and Nanstad, R. K. and Server, W. L. and Eason, E. D.},
  journal={Journal of Nuclear Materials},
  volume={526},
  pages={151863},
  year={2019},
  publisher={Elsevier}
}

Este artículo constituye la revisión más exhaustiva sobre la evolución y el estado actual de los modelos predictivos de fragilización en aceros de vasija. Analiza los mecanismos microestructurales del daño por irradiación y evalúa críticamente las correlaciones empíricas. Detalla específicamente el desarrollo, la formulación y las limitaciones intrínsecas de estándares como la norma ASTM E900-15.

Se añade para respaldar con la máxima autoridad académica las debilidades del enfoque analítico tradicional empleado por la industria. Valida tu afirmación de que la norma ASTM es una simplificación empírica con rigideces estructurales. De esta forma, legitimas la necesidad imperativa de buscar metodologías capaces de asimilar tendencias multivariables complejas.

@article{mathew2018reactor,
  title={Reactor pressure vessel embrittlement: Insights from neural network modelling},
  author={Mathew, J. and Parfitt, D. and Riddle, N. and Chard-Tuckey, P.},
  journal={Journal of Nuclear Materials},
  volume={502},
  pages={311--322},
  year={2018},
  publisher={Elsevier}
}

Este artículo emplea redes neuronales para modelar la fragilización en aceros de vasija utilizando bases de datos de vigilancia (como NUREG). Aunque demuestra una alta precisión al interpolar los efectos de la irradiación, los autores evidencian los problemas del modelo al enfrentarse a conjuntos de datos con lagunas. Subraya las limitaciones intrínsecas de las redes "caja negra" cuando las variables escapan de su dominio estricto de entrenamiento.

Aporta un caso de estudio real y específico de tu sector donde el Machine Learning convencional muestra sus carencias estructurales. Documenta a la perfección la dependencia crítica de la densidad de datos, respaldando tu argumento sobre el peligro de la extrapolación ciega. Esto construye el puente lógico ideal para justificar tu propuesta de utilizar arquitecturas híbridas informadas por la física (PINNs).

@article{raissi2019physics,
  title={Physics-informed neural networks: A deep learning framework for solving forward and inverse problems involving nonlinear partial differential equations},
  author={Raissi, Maziar and Perdikaris, Paris and Karniadakis, George E},
  journal={Journal of Computational Physics},
  volume={378},
  pages={686--707},
  year={2019},
  publisher={Elsevier}
}

Es la publicación seminal que introdujo y formalizó la arquitectura de las Redes Neuronales Informadas por Física en la comunidad científica. Establece el marco matemático para integrar leyes fundamentales y ecuaciones gobernantes directamente en la función de pérdida. Demuestra cómo esta técnica restringe el aprendizaje a soluciones viables, superando la escasez de datos.

Es una cita técnica obligatoria al introducir la metodología central de tu trabajo por primera vez en el documento. Ancla tu propuesta a un marco teórico sólidamente validado para problemas de mecánica y modelado de materiales. Justifica matemáticamente que la hibridación del conocimiento es una estrategia computacional superior y establecida.





